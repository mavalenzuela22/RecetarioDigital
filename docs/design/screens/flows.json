{
  "version": "1.0.0",
  "currency": "MXN",
  "locale": "es-MX",
  "flows": [
    {
      "id": "hoy",
      "title": "Hoy en tu cocina",
      "scenario": "18 sep 2026, inicio de jornada; pedidos confirmados por preparar",
      "nav": "Hoy",
      "layout": [
        "brand36",
        "title32/date16",
        "production-thumbnail104x64 + two rows60",
        "delivery-heading22 + two rows60",
        "money-summary2columns",
        "actions52+52",
        "bottom-navigation72+safeArea"
      ],
      "primary": "Ver producción",
      "secondary": "Registrar compra",
      "transitions": {
        "Ver producción": "produccion",
        "Registrar compra": "compra",
        "pedido Ana/Luis": "cobro"
      },
      "states": {
        "empty": "No tienes pedidos para hoy. Tomar pedido.",
        "loading": "Cargando tu día…",
        "error": "No pudimos cargar tu día. Reintentar.",
        "partial": "Hay pedidos sin costo completo. Se muestra venta y saldo; ganancia pendiente de calcular."
      },
      "rules": [
        "sumar solo pedidos activos de la fecha del negocio",
        "no contar anticipos como ganancia",
        "cancelados excluidos",
        "saldo=total-pagos; no borrar deuda de entregados",
        "ganancia estimada identificada; si falta costo no usar cero"
      ]
    },
    {
      "id": "compra",
      "title": "Registrar compra",
      "nav": null,
      "layout": [
        "back48",
        "title28 + help14",
        "ingredient52",
        "presentation52",
        "quantity52 + unit104wide",
        "total52",
        "date52",
        "optional-details48",
        "normalized-summary",
        "sticky-save52"
      ],
      "fields": [
        {
          "key": "ingredient",
          "label": "Ingrediente",
          "required": true,
          "type": "string",
          "max": 120
        },
        {
          "key": "presentation",
          "label": "Presentación",
          "required": true,
          "type": "string",
          "max": 120
        },
        {
          "key": "quantity",
          "label": "Cantidad comprada",
          "required": true,
          "type": "decimal-string",
          "minExclusive": "0",
          "scale": 3
        },
        {
          "key": "unit",
          "label": "Unidad",
          "required": true,
          "enum": [
            "g",
            "kg",
            "ml",
            "l",
            "piece"
          ]
        },
        {
          "key": "totalPaid",
          "label": "Total pagado",
          "required": true,
          "type": "decimal-string",
          "minExclusive": "0",
          "scale": 2
        },
        {
          "key": "date",
          "label": "Fecha",
          "required": true,
          "type": "local-date"
        },
        {
          "key": "store",
          "label": "Tienda o proveedor",
          "required": false,
          "max": 120
        },
        {
          "key": "note",
          "label": "Nota",
          "required": false,
          "max": 2000
        }
      ],
      "primary": "Guardar compra",
      "states": {
        "invalidTotal": "Escribe un total mayor que $0.",
        "invalidQuantity": "Escribe una cantidad mayor que cero.",
        "saving": "Guardando compra…",
        "success": "Compra registrada.",
        "network": "No se guardó la compra. Tus datos siguen aquí. Reintentar."
      },
      "rules": [
        "presentación describe; quantity es contenido total, no número de paquetes salvo pieza",
        "g/ml/pieza canónicos",
        "costo normalizado solo lectura 4–6dp",
        "servidor calcula; compra append-only",
        "mantener borrador y campos válidos",
        "back dirty: Seguir editando / Descartar cambios"
      ]
    },
    {
      "id": "receta",
      "title": "Receta",
      "nav": null,
      "layout": [
        "back",
        "title/version",
        "optional-image350x180",
        "name",
        "ingredients list",
        "yield",
        "instructions",
        "notes",
        "cost disclosure",
        "version notice",
        "sticky-save"
      ],
      "fields": [
        {
          "key": "name",
          "required": true,
          "max": 120
        },
        {
          "key": "ingredients",
          "required": true,
          "minItems": 1,
          "row": [
            "ingredientId",
            "quantity decimal>0",
            "compatibleUnit"
          ]
        },
        {
          "key": "yield",
          "label": "Rendimiento esperado",
          "type": "integer",
          "min": 1
        },
        {
          "key": "instructions",
          "label": "Preparación",
          "max": 10000
        },
        {
          "key": "notes",
          "max": 2000
        },
        {
          "key": "image",
          "required": false,
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ],
          "maxBytes": 5242880
        }
      ],
      "primary": "Guardar receta",
      "secondary": "Agregar ingrediente",
      "states": {
        "empty": "Agrega el primer ingrediente.",
        "missingCost": "Falta el costo de un ingrediente. No podemos calcular el total.",
        "invalidYield": "Escribe un número entero mayor que cero.",
        "success": "Receta guardada como nueva versión."
      },
      "rules": [
        "editar composición/rendimiento crea versión o snapshot económico",
        "costo receta no incluye dos veces empaque/entrega del producto",
        "sin foto no bloquea",
        "nueva receta usa campos vacíos; edición muestra versión vigente",
        "quitar ingrediente se confirma si perdería trabajo; recalcular con respuesta server"
      ]
    },
    {
      "id": "producto",
      "title": "Costos y precio",
      "nav": null,
      "layout": [
        "back/title/unit",
        "cost card",
        "breakdown disclosure",
        "scenario buttons x2/x2.5/x3/x3.5",
        "scenario result4metrics",
        "Use price",
        "additional-cost editor",
        "manual price",
        "active switch",
        "history link"
      ],
      "primary": "Usar este precio",
      "fields": [
        {
          "key": "recipeId",
          "required": true
        },
        {
          "key": "saleUnit",
          "value": "pieza",
          "required": true
        },
        {
          "key": "salePrice",
          "type": "decimal-string",
          "scale": 2,
          "minExclusive": "0"
        },
        {
          "key": "extraCosts",
          "row": [
            "concept",
            "amount decimal>=0",
            "allocation batch|unit|order"
          ]
        },
        {
          "key": "active",
          "type": "boolean"
        }
      ],
      "states": {
        "unknown": "Falta información para calcular el costo.",
        "negativeProfit": "Pérdida por pieza",
        "zeroPrice": "Margen no calculable con precio $0.",
        "confirm": "Este precio se aplicará a nuevos pedidos. Los anteriores conservan el precio acordado."
      },
      "rules": [
        "explorar no persiste",
        "multiplier=price/cost; margin=profit/price",
        "line/order allocation explicit reference denominator",
        "guardar precio agrega historial effective-dated",
        "inactivo oculta de nuevos pedidos y conserva históricos"
      ]
    },
    {
      "id": "pedido",
      "title": "Tomar pedido",
      "nav": null,
      "layout": [
        "back/title",
        "customer select/create",
        "product picker",
        "line quantities+snapshot prices",
        "delivery date/time",
        "notes",
        "advance",
        "total/paid/balance",
        "sticky-save"
      ],
      "fields": [
        {
          "key": "customer",
          "required": true,
          "max": 120
        },
        {
          "key": "lines",
          "minItems": 1,
          "row": [
            "productId",
            "quantity integer>=1",
            "agreedPrice decimal>0"
          ]
        },
        {
          "key": "deliveryDate",
          "type": "local-date",
          "required": true
        },
        {
          "key": "deliveryTime",
          "type": "local-time",
          "required": true
        },
        {
          "key": "notes",
          "max": 2000
        },
        {
          "key": "paidAmount",
          "type": "decimal-string",
          "min": "0",
          "max": "orderTotal"
        }
      ],
      "primary": "Guardar pedido",
      "states": {
        "emptyProducts": "Agrega al menos un producto.",
        "invalidAdvance": "El anticipo debe estar entre $0 y el total.",
        "success": "Pedido registrado.",
        "unavailable": "Ese producto ya no está disponible. Conservamos el resto del pedido."
      },
      "rules": [
        "elegir/crear nombre no construye CRM",
        "nuevo cliente mismo campo: Crear nombre; sin campos corporativos",
        "snapshots precio y costo por línea",
        "mas/menos enteros; quitar línea distinto de disminuir a cero",
        "pedido multi-producto usa lista vertical, total siempre visible en cierre",
        "pago parcial no implica confirmación de entrega"
      ]
    },
    {
      "id": "cobro",
      "title": "Cobro y entrega",
      "scenario": "18 sep2026 12:20; Ana lista para entregar; saldo240",
      "nav": null,
      "layout": [
        "back/customer/time",
        "fulfillment and payment chips",
        "order lines",
        "total/paid/balance",
        "payment action",
        "delivery action",
        "payment history",
        "notes",
        "cancel action"
      ],
      "primary": "Registrar cobro",
      "secondary": "Marcar como entregado",
      "fields": [
        {
          "key": "paymentAmount",
          "required": true,
          "minExclusive": "0",
          "max": "remainingBalance",
          "scale": 2
        },
        {
          "key": "paymentDate",
          "type": "local-date",
          "required": true
        }
      ],
      "states": {
        "partial": "Pago parcial",
        "paid": "Pagado; saldo $0.00",
        "deliveredUnpaid": "Entregado + Pendiente de cobro",
        "confirmation": "¿Entregaste las 12 piezas a Ana?",
        "invalidPayment": "Escribe un importe mayor que $0 y no mayor que el saldo.",
        "cancelWithAdvance": "Cancelar no registra una devolución."
      },
      "rules": [
        "cada cobro conserva registro; idempotencia por envío",
        "entrega y pago mutan independientemente",
        "con saldo0 ocultar/deshabilitar Registrar cobro explicando Pagado",
        "confirmar entrega explícita",
        "cancelación no borra historial ni reembolsa automáticamente"
      ]
    },
    {
      "id": "produccion",
      "title": "Producción",
      "nav": null,
      "layout": [
        "back/title",
        "date or date-window selector",
        "aggregate units/orders",
        "product groups with constituent orders",
        "revenue/cost/profit",
        "start production"
      ],
      "primary": "Iniciar preparación",
      "fields": [
        {
          "key": "from",
          "type": "local-date",
          "required": true
        },
        {
          "key": "to",
          "type": "local-date",
          "required": false,
          "default": "from"
        }
      ],
      "states": {
        "empty": "No hay pedidos por preparar en esta fecha.",
        "missingCost": "Venta estimada disponible. Costo y ganancia pendientes por ingredientes sin costo.",
        "loading": "Agrupando pedidos…",
        "success": "Pedidos en preparación."
      },
      "rules": [
        "agrupa pedidos activos; excluye cancelados y entregados de trabajo pendiente",
        "mantiene asociación piezas→pedidos",
        "rango inclusivo en zona de negocio",
        "iniciar no marca listo/entregado/pagado",
        "preparación utiliza receta/costo snapshot del pedido"
      ]
    },
    {
      "id": "historial",
      "title": "Antes y ahora",
      "nav": null,
      "layout": [
        "back/product/title",
        "two date fields",
        "compare action",
        "cost delta",
        "price/profit/margin comparison",
        "drivers",
        "provenance disclosure",
        "pricing action"
      ],
      "primary": "Comparar fechas",
      "secondary": "Explorar otro precio",
      "fields": [
        {
          "key": "asOf",
          "type": "local-date",
          "required": true
        },
        {
          "key": "until",
          "type": "local-date",
          "required": true,
          "min": "asOf"
        }
      ],
      "states": {
        "missingSnapshot": "No hay una referencia económica para esa fecha. Elige otra fecha.",
        "differentRecipe": "La receta o el rendimiento cambiaron. Compara el desglose de cada versión.",
        "invalidRange": "La fecha final debe ser igual o posterior a la inicial.",
        "loading": "Buscando referencias históricas…"
      },
      "rules": [
        "sin interpolación ni historia inventada",
        "última referencia vigente al cierre de cada fecha local",
        "precisar si compara economía producto o pedidos reales",
        "variación absoluta + porcentaje; base0 porcentaje no calculable",
        "drivers solo si estados comparables; separar cambios de receta/rendimiento",
        "no recalcular pedidos históricos con última compra"
      ]
    }
  ],
  "breakpoints": {
    "320": "padding16; wrap amounts; stack date pair",
    "390": "padding20; one flow column",
    "768": "flow480; dialogs centered",
    "1200": "content1120; optional list/detail split; form max480"
  }
}
